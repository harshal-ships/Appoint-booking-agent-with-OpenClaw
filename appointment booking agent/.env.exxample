# Telcoflow (inbound voice)
WSS_API_KEY=your_telcoflow_api_key
WSS_CONNECTOR_UUID=your_telcoflow_connector_uuid

# AWS Bedrock — Nova Sonic 2 live voice + Nova text post-call (Python 3.12+)
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=matthew
NOVA_TEXT_MODEL=amazon.nova-lite-v1:0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Calendar via gog CLI (OAuth — NOT service-account JSON)
# Setup: openclaw skills install gog && gog auth
GOOGLE_CALENDAR_ID=primary

# OpenClaw WhatsApp (WhatsApp Web — link with: openclaw channels login --channel whatsapp)
# Gateway must run: openclaw gateway
DEFAULT_PHONE_COUNTRY_CODE=91
# Clinic staff — full booking details for review & confirm (required for clinic alerts)
WHATSAPP_CLINIC_NUMBER=
WHATSAPP_OPENCLAW_ACCOUNT=

GOG_BIN=gog

# App paths / clinic settings
BOOKINGS_PATH=bookings.json
CLINIC_TIMEZONE=Asia/Singapore
APPOINTMENT_DURATION_MINUTES=30
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=17
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=true
